/feed/*
  Content-Type: application/atom+xml; charset=utf-8

/assets/*
  Cache-Control: public, max-age=86400

/media/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; connect-src 'self' https://bartsspace.goatcounter.com; img-src 'self' data: https://bartsspace.goatcounter.com; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://share.transistor.fm; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
